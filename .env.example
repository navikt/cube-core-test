# Cube.js settings
CUBEJS_API_SECRET=change-me-use-a-long-random-string
CUBEJS_DEV_MODE=true
CUBEJS_LOG_LEVEL=info

# Database (maps to Nais DB_* env vars in dev-gcp)
# In Docker Compose, DB_HOST must be the service name, not localhost
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cube_dev
DB_USERNAME=cube
DB_PASSWORD=cube
# BigQuery (uses Application Default Credentials on Nais via Workload Identity)
# For local dev: run `gcloud auth application-default login` first
BQ_PROJECT_ID=nada-dev-db2e
BQ_DATASET=dataproducts
# Project to bill BigQuery queries against (your personal/team dev project).
# On Nais this is handled by Workload Identity; locally set it explicitly.
BQ_BILLING_PROJECT=dataplattform-dev-ae96
